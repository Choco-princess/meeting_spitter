{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meeting-spitter-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://choco-princess.github.io,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173",
    "SERVICE_ENABLED": "true",
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
